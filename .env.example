# Copie para .env e preencha com os valores do projeto Supabase:
# Dashboard → Project Settings → API

# URL do projeto (segura para o browser; não é um segredo forte)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Chave anon/public (pode ir no frontend; a segurança vem do RLS/RPCs)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# NÃO coloque a service_role key no frontend nem neste arquivo.
